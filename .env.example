# Optional: FoodData Central key, available at https://fdc.nal.usda.gov/api-key-signup
# Keep it on the server. Never name this VITE_USDA_API_KEY.
# If omitted, the public USDA DEMO_KEY is used with its small shared limits.
USDA_API_KEY=

# Local MySQL and backend. Generate actual values with npm run db:configure.
# Never use these placeholder strings as passwords.
MYSQL_DATABASE=fitin
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
MYSQL_MIGRATION_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_POOL_SIZE=5
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5300
